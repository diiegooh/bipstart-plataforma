# Configure no Northflank. Nunca adicione senhas nem chaves secretas ao GitHub.
PORT=3000
SUPABASE_URL=
# Chave pública publishable (sb_publishable_...). NÃO usar service_role.
SUPABASE_PUBLISHABLE_KEY=
# Ativar cobrança somente após migrações e testes de pagamento:
# MERCADO_PAGO_ACCESS_TOKEN=
# SUPABASE_SERVICE_ROLE_KEY=

# Envio automático pelo WhatsApp Business Cloud API (Meta), somente com consentimento.
# Configure os segredos no Northflank, nunca no navegador nem no GitHub.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
# Nome do template de utilidade aprovado com 5 variáveis (ver README).
WHATSAPP_TEMPLATE_ORDER_UPDATE=bipstart_atualizacao_pedido
